# Copie para .env e troque os valores. NUNCA faça commit do .env.
# Todos os valores abaixo são EXEMPLOS (placeholders), não funcionam.

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Token que o app Android envia (Authorization: Bearer ...). Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_TOKEN=TROQUE_POR_UM_TOKEN_ALEATORIO_DE_64_CARACTERES

# IA grátis (Google Gemini, aistudio.google.com → Get API key). Usada quando não há ANTHROPIC_API_KEY.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest

# IA paga (Anthropic). Se existir, tem prioridade sobre o Gemini.
ANTHROPIC_API_KEY=sk-ant-EXEMPLO
AI_MODEL=claude-opus-5-5
# Limite diário de gerações de texto (evita gasto acidental).
AI_DAILY_LIMIT=300

# Shopee Afiliados (Open API). Precisa de aprovação da Shopee para a sua conta.
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# Mercado Livre (consulta de produto). Não existe API oficial para gerar link de afiliado.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# Telegram (publicação automática oficial em canal ou grupo onde o bot é admin).
TELEGRAM_BOT_TOKEN=

# WhatsApp automático (número próprio, conexão por código). Ver docs/WHATSAPP.md.
# Banco Postgres grátis (Supabase → Connect → Session pooler) para guardar a sessão.
DATABASE_URL=
# Mínimo de minutos entre duas mensagens no mesmo grupo.
WA_INTERVALO_MIN=10
# Máximo de mensagens por dia em cada grupo.
WA_MAX_DIA=40

# ---------- Venda do app (só no SEU servidor central) ----------
# Chave privada das licenças (gerada uma vez; nunca compartilhe). Liga /site, /admin e a ativação.
LICENCA_CHAVE_PRIVADA=
# Senha do painel /admin (mínimo 32 caracteres).
ADMIN_TOKEN=
# Webhooks das plataformas de venda.
KIWIFY_TOKEN=
HOTMART_HOTTOK=
# Produto → plano: "idDoProduto:essencial,idDoProduto:pro,idDoProduto:premium"
PRODUTOS_PLANOS=
# Links de compra e de suporte na página de vendas.
LINK_ESSENCIAL=
LINK_PRO=
LINK_PREMIUM=
LINK_SUPORTE=
# Venda pelo WhatsApp: só números com 55. Os botões do site abrem este WhatsApp.
WHATSAPP_VENDAS=
# E-mail da chave (brevo.com, grátis): chave da API (SMTP & API → API Keys) e o remetente verificado.
BREVO_API_KEY=
EMAIL_REMETENTE=
